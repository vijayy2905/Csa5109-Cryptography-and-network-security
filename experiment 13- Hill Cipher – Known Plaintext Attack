import numpy as np
def inverse_matrix_mod26(matrix):
    det = int(round(np.linalg.det(matrix))) % 26
    for x in range(26):
        if (det * x) % 26 == 1:
            inv_det = x
            break
    else:
        return None
    a = int(matrix[0][0])
    b = int(matrix[0][1])
    c = int(matrix[1][0])
    d = int(matrix[1][1])
    inverse = np.array([
        [d * inv_det, -b * inv_det],
        [-c * inv_det, a * inv_det]
    ]) % 26
    return inverse
plaintext = input("Enter 4-letter known plaintext: ").upper()
ciphertext = input("Enter corresponding 4-letter ciphertext: ").upper()
P = np.array([
    [ord(plaintext[0]) - 65, ord(plaintext[2]) - 65],
    [ord(plaintext[1]) - 65, ord(plaintext[3]) - 65]
])
C = np.array([
    [ord(ciphertext[0]) - 65, ord(ciphertext[2]) - 65],
    [ord(ciphertext[1]) - 65, ord(ciphertext[3]) - 65]
])
P_inv = inverse_matrix_mod26(P)
if P_inv is None:
    print("Plaintext matrix has no inverse modulo 26.")
else:
    key = (C @ P_inv) % 26
    print("Recovered Key Matrix:")
    print(key)

key = input("Enter Keyword: ").upper()
key = key.replace("J", "I")
matrix = []
for ch in key:
    if ch.isalpha() and ch not in matrix:
        matrix.append(ch)
for ch in "ABCDEFGHIKLMNOPQRSTUVWXYZ":
    if ch not in matrix:
        matrix.append(ch)
print("Playfair Matrix:")
for i in range(0, 25, 5):
    print(*matrix[i:i+5])
